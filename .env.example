# ShinkaLife is a static site: browsers cannot read environment variables at runtime, so the PUBLIC values live in js/config.js.
# This file documents them (and the names to use if you ever add a build tool such as Vite).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Optional, server-side AI function URL (not a key):
AI_ENDPOINT=
# NEVER commit or put in any frontend file: service_role key, sb_secret_ keys, database password, AI provider keys, signing keystores.
